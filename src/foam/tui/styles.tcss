/* WP-09 深色主题(一套,不做主题系统)。
   语义色(D4):阶段 cyan / 成功 green / 失败 red / 警告 yellow / 思考 gray /
   插话 blue;所有状态同时有文字标记(不只靠颜色)。 */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* ---------- 迎宾屏 ---------- */

WelcomeScreen {
    align: center middle;
}

#gate {
    width: auto;
    height: auto;
    align: center middle;
}

#wm-logo {
    text-align: center;
}

#wm-version {
    color: #8b949e;
    text-align: center;
}

#wm-meta {
    color: #e6edf3;
    text-align: center;
    margin-top: 1;
}

#wm-redline {
    color: #d29922;
    text-align: center;
    margin: 1 0;
}

#callsign {
    width: 42;
    border: solid #30363d;
    background: #161b22;
}

#callsign:focus {
    border: solid #56d4dd;
}

#gate-error {
    color: #f85149;
    text-align: center;
}

#wm-hint {
    color: #8b949e;
    text-align: center;
    margin-top: 1;
}

/* ---------- 动效迎宾屏(Strix 对齐) ---------- */

LandingScreen {
    align: center middle;
    background: #090d12;
}

#landing-shell {
    width: 68;
    max-width: 92%;
    height: auto;
    align: center middle;
}

#landing-logo {
    width: 100%;
    height: auto;
    text-align: center;
}

#landing-tagline {
    width: 100%;
    height: auto;
    text-align: center;
    color: #8b949e;
    margin: 1 0 1 0;
}

#landing-card {
    width: 100%;
    height: auto;
    border: round #38bdf8;
    background: #0d1117;
    padding: 1 2;
}

#landing-input-row {
    width: 100%;
    height: 1;
}

#landing-prompt-glyph {
    width: 2;
    height: 1;
    color: #38bdf8;
    text-style: bold;
}

#landing-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: #e6edf3;
}

#landing-input:focus {
    border: none;
}

#landing-targets {
    width: 100%;
    height: auto;
    color: #56d4dd;
    margin-top: 1;
}

#landing-model-row {
    width: 100%;
    height: 1;
    margin-top: 2;
}

#landing-model {
    width: 100%;
    height: 1;
}

#landing-picker-slot {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#landing-probe {
    width: 100%;
    height: auto;
    color: #8b949e;
    padding: 0 1;
    margin-top: 1;
}

#landing-footer {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-top: 1;
}

#landing-keys {
    width: 1fr;
    height: 1;
}

#landing-version {
    width: auto;
    height: 1;
    color: #8b949e;
    text-align: right;
}

/* ---------- 顶栏 ---------- */

#statusbar {
    height: 1;
    background: #161b22;
    padding: 0 1;
}

#sb-left {
    width: auto;
    margin-right: 2;
    color: #e6edf3;
    text-style: bold;
    text-wrap: nowrap;
}

#sb-center {
    width: 1fr;
    padding: 0 1;
    text-align: center;
    color: #8b949e;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sb-right {
    width: auto;
    margin-left: 2;
    text-align: right;
    text-wrap: nowrap;
}

/* ---------- 主区/侧栏布局 ---------- */

#main {
    height: 1fr;
}

#narrative {
    width: 1fr;
    padding: 0 1;
    scrollbar-color: #30363d;
}

#sidebar {
    width: 30;
    background: #161b22;
    border-left: solid #30363d;
    padding: 0 1;
}

.side-title {
    color: #56d4dd;
    text-style: bold;
    margin-top: 1;
}

/* ---------- 叙述流块 ---------- */

.stream {
    color: #e6edf3;
    height: auto;
}

.phase-divider {
    color: #56d4dd;
    text-style: bold;
    text-align: center;
    margin-top: 1;
    height: auto;
}

.notice {
    padding: 0 1;
    height: auto;
}

.notice.ok { color: #3fb950; }
.notice.fail { color: #f85149; }
.notice.warn { color: #d29922; }
.notice.dim { color: #8b949e; }
.notice.phase { color: #56d4dd; }
.notice.blue { color: #58a6ff; }

/* ---------- 内联欢迎条(Strix 对齐) ---------- */

#welcome-banner {
    border: round #30363d;
    background: #161b22;
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
}

#banner-title {
    color: #56d4dd;
    text-style: bold;
    height: auto;
}

#banner-meta {
    color: #8b949e;
    height: auto;
}

#banner-hint {
    color: #c9d1d9;
    height: auto;
}

/* ---------- 思考块(gray,默认折叠) ---------- */

.thinking {
    border-left: solid #30363d;
    padding-left: 1;
    height: auto;
}

.thinking.active {
    border-left: solid #56d4dd;
}

.thinking.active.pulse {
    border-left: solid #58a6ff;
}

.thinking.done {
    border-left: solid #30363d;
}

.thinking:focus {
    border-left: solid #8b949e;
}

.thinking-header {
    color: #8b949e;
    height: auto;
}

.thinking-preview {
    color: #8b949e;
    text-style: italic;
    padding-left: 2;
    max-height: 3;
    height: auto;
}

.thinking-body {
    color: #8b949e;
    text-style: italic;
    background: #161b22;
    padding: 0 1;
    height: auto;
}

/* ---------- 工具卡(紧凑流) ---------- */

.toolcard {
    border-left: solid #30363d;
    padding-left: 1;
    height: auto;
}

.toolcard:focus {
    border-left: solid #e6edf3;
}

.card-header {
    height: auto;
}

.toolcard.running .card-header { color: #e6edf3; }
.toolcard.ok .card-header { color: #3fb950; }
.toolcard.fail .card-header { color: #f85149; }
.toolcard.warn .card-header { color: #d29922; }
.toolcard.denied .card-header {
    color: #f85149;
    text-style: bold;
}

.card-body {
    color: #c9d1d9;
    background: #161b22;
    padding: 0 1;
    height: auto;
}

/* ---------- scope 确认卡(WP-14c) ---------- */

#scopecard {
    border: solid #56d4dd;
    padding: 0 1;
    margin: 1 0;
    height: auto;
}

#scope-card-title {
    text-style: bold;
    color: #56d4dd;
    height: auto;
}

#scope-card-body {
    color: #e6edf3;
    background: #161b22;
    padding: 0 1;
    margin: 1 0;
    height: auto;
}

/* Q9 空规则集 / 编译失败:颜色 + 粗体第二通道(不只靠颜色) */
#scope-card-body.scope-empty {
    color: #d29922;
    text-style: bold;
}

#scope-card-body.scope-error {
    color: #f85149;
}

#scope-card-status {
    color: #8b949e;
    height: auto;
}

#scope-card-buttons {
    height: auto;
    margin-top: 1;
}

#scope-card-buttons Button {
    margin-right: 2;
}

#scope-correction {
    border: solid #30363d;
    background: #161b22;
    height: auto;
}

#scope-correction:focus {
    border: solid #56d4dd;
}

/* ---------- 模型选择器卡(/model) ---------- */

#modelcard {
    border: solid #56d4dd;
    padding: 0 1;
    margin: 1 0;
    height: auto;
}

#model-card-title {
    text-style: bold;
    color: #56d4dd;
    height: auto;
}

#model-card-status {
    color: #8b949e;
    height: auto;
}

#model-list {
    max-height: 10;
    height: auto;
    background: #161b22;
    border: solid #30363d;
    margin: 1 0;
}

#model-custom-input {
    border: solid #30363d;
    background: #161b22;
    height: auto;
}

#model-custom-input:focus {
    border: solid #56d4dd;
}

#model-card-buttons {
    height: auto;
    margin-top: 1;
}

#model-card-buttons Button {
    margin-right: 2;
}

/* ---------- kill 确认条 ---------- */

#killbar {
    background: #f85149;
    color: #0d1117;
    text-style: bold;
    padding: 0 1;
    height: auto;
}

/* ---------- 输入坞 ---------- */

#inputdock {
    height: auto;
}

#completion {
    max-height: 7;
    background: #161b22;
    border: solid #30363d;
    padding: 0 1;
}

#input {
    border: solid #30363d;
    background: #161b22;
}

#input:focus {
    border: solid #56d4dd;
}
